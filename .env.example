# ─────────────────────────────────────────────
# Firebase 클라이언트 (브라우저 노출 OK — 보안은 Auth + Firestore Rules + App Check)
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3 Enterprise site key — 공개 노출 OK)
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────
# Firebase Admin (서버 전용 — 절대 NEXT_PUBLIC_ 금지)
# 서비스 계정 JSON 한 줄 압축 또는 base64 인코딩 권장
# ─────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─────────────────────────────────────────────
# Discord OAuth (서버 전용)
# https://discord.com/developers/applications 에서 발급
# Redirect URI: {APP_URL}/api/auth/discord/callback
# ─────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ─────────────────────────────────────────────
# 앱 설정
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth state / 세션 서명용 (32바이트 이상 랜덤 문자열)
AUTH_SECRET=

# ─────────────────────────────────────────────
# 사이트 운영자 (공지사항 작성·버그리포트 답변 권한)
# Firebase Auth uid 쉼표 구분. 절대 NEXT_PUBLIC_ 금지.
# ex) ADMIN_UIDS=uid_one,uid_two
# ─────────────────────────────────────────────
ADMIN_UIDS=
